# Biến môi trường backend cho uvicorn serve.app_llm:app (KHÔNG commit file .env thật lên git)
SYSTEM=mypkg.waste_ai:run
LLM_PROVIDER=gemini

# --- Gemini API (mặc định, dùng SDK google-genai >= 2.30.1) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Hoặc OpenAI API (nếu chuyển LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

MAX_CHARS=1500000
TIMEOUT_S=20
MAX_INFLIGHT=8
